---
import { config } from '../../config/site';
import type { Round, SeriesConfig } from '../types';

interface Props {
  series: SeriesConfig;
  round: Round;
}

const { series, round } = Astro.props;
const layout = round.layout?.trim();
const date = new Intl.DateTimeFormat(config.site.locale, {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  timeZone: config.site.timeZone,
}).format(new Date(round.date));
---

<section class="latest-result-strip" aria-label="最近赛果">
  <a class="latest-result-link shell" href={`/racing/${series.slug}/results/${round.id}`}>
    <span class="latest-result-label">最近赛果</span>
    <div class="latest-result-event">
      <strong>{series.shortName || series.name} · 第 {round.round} 轮 · {round.track}{layout && <span class="latest-result-layout"> · {layout}</span>}</strong>
      <time class="latest-result-meta" datetime={round.date}>{date}</time>
    </div>
    <span class="latest-result-action">查看赛果 <span aria-hidden="true">→</span></span>
  </a>
</section>

<style>
  .latest-result-strip {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }
  .latest-result-link {
    display: grid;
    grid-template-columns: minmax(80px, 1fr) minmax(0, auto) minmax(80px, 1fr);
    align-items: center;
    gap: 20px;
    min-height: 48px;
    padding-block: 10px;
  }
  .latest-result-label {
    color: var(--muted);
    font-size: 12px;
    font-weight: 650;
    white-space: nowrap;
  }
  .latest-result-event { display: flex; flex-wrap: wrap; justify-content: center; align-items: baseline; gap: 4px 16px; min-width: 0; text-align: center; }
  .latest-result-event strong {
    min-width: 0;
    font-size: 13px;
    font-weight: 650;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .latest-result-meta {
    flex: 0 0 auto;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.5;
    white-space: nowrap;
  }
  .latest-result-layout { color: var(--muted); font-weight: 400; }
  .latest-result-action {
    display: flex;
    justify-self: end;
    align-items: center;
    gap: 12px;
    color: var(--accent-text);
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .latest-result-link { grid-template-columns: minmax(0, 1fr) auto; min-height: 64px; gap: 6px 16px; }
    .latest-result-label { grid-column: 1; grid-row: 1; font-size: 11px; }
    .latest-result-event { display: contents; text-align: left; }
    .latest-result-meta { grid-column: 2; grid-row: 1; font-size: 11px; text-align: right; }
    .latest-result-event strong { grid-column: 1; grid-row: 2; }
    .latest-result-action { grid-column: 2; grid-row: 2; gap: 8px; font-size: 12px; }
  }
</style>
