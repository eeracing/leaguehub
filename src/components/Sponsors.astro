---
import { sponsors } from '../../config/sponsors';
import SectionHeading from './SectionHeading.astro';

const visibleSponsors = [...sponsors].sort((a, b) => (a.order ?? 0) - (b.order ?? 0));
---

{visibleSponsors.length > 0 && <section class="content-section sponsors-section">
  <div class="shell">
    <SectionHeading title="合作伙伴" />
    <div class="sponsors-grid">
      {visibleSponsors.map((sponsor) => {
        const Card = sponsor.url ? 'a' : 'div';
        return <Card class="sponsor-card" href={sponsor.url} target={sponsor.url ? '_blank' : undefined} rel={sponsor.url ? 'noopener noreferrer' : undefined} aria-label={sponsor.url ? `访问 ${sponsor.name} 网站（在新窗口打开）` : undefined}>
          <span class="sponsor-logo"><img src={sponsor.logo} alt={sponsor.name} width="190" height="68" loading="lazy" /></span>
          <span class="sponsor-name">{sponsor.name}</span>
        </Card>;
      })}
    </div>
  </div>
</section>}
