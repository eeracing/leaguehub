---
import ResultDetailsDialog from './ResultDetailsDialog.astro';
import TableScroll from './TableScroll.astro';
import { getFastestLap } from '../lib/points';
import { certificateUrl } from '../lib/certificates';
import { positionChange, resultStatus, validPosition } from '../lib/result-presentation';
import type { RacePenalty, ScoredRace } from '../types';
interface Props { race: ScoredRace; showIncidents?: boolean; limit?: number; certificateDriverIds?: string[]; seriesSlug?: string }
const { race, showIncidents = false, limit, certificateDriverIds = [], seriesSlug } = Astro.props;
const fastest = getFastestLap(race);
const results = limit ? race.results.slice(0, limit) : race.results;
const certificateIds = new Set(certificateDriverIds);
// Keep small fractions while hiding floating-point noise in displayed totals.
const numberFormat = new Intl.NumberFormat('zh-CN', { useGrouping: false, maximumSignificantDigits: 15 });

function penaltyValue(penalty: RacePenalty) {
  if (penalty.type === 'time') return `+${numberFormat.format(penalty.seconds)} 秒`;
  if (penalty.type === 'position') {
    return `后退 ${penalty.positions} 位`;
  }
  if (penalty.type === 'points') {
    return `扣除 ${numberFormat.format(penalty.points)} 分`;
  }
  return '取消资格';
}

function penaltySummary(penalties: RacePenalty[]): { text: string; totalLabel: string } {
  if (penalties.every((penalty) => penalty.type === 'time')) {
    const seconds = penalties.reduce((total, penalty) => penalty.type === 'time' ? total + penalty.seconds : total, 0);
    return { text: `+${numberFormat.format(seconds)} 秒`, totalLabel: '累计罚时' };
  }
  if (penalties.every((penalty) => penalty.type === 'points')) {
    const points = penalties.reduce((total, penalty) => penalty.type === 'points' ? total + penalty.points : total, 0);
    return { text: `扣除 ${numberFormat.format(points)} 分`, totalLabel: '累计扣分' };
  }
  return { text: penalties.length === 1 ? penaltyValue(penalties[0]) : `处罚 ${penalties.length} 项`, totalLabel: '处罚汇总' };
}

function penaltyLabel(penalty: RacePenalty): string {
  if (penalty.type === 'time') return '罚时';
  if (penalty.type === 'position') return '罚退';
  if (penalty.type === 'points') return '扣分';
  return '取消资格';
}

function signedPoints(points: number): string {
  return points > 0 ? `+${numberFormat.format(points)}` : numberFormat.format(points);
}
---
<TableScroll label="正赛成绩，可横向滚动">
  <table class="results-table">
    <thead><tr><th scope="col" class="pos">排名</th><th scope="col" class="number">车号</th><th scope="col" class="driver">车手</th><th scope="col" class="grid-column">发车位</th><th scope="col" class="change-column">变化</th><th scope="col">赛车</th><th scope="col">圈数</th><th scope="col">完赛状态</th><th scope="col">时间差</th><th scope="col">最快圈</th>{showIncidents && <th scope="col" class="incidents-column">事故</th>}<th scope="col" class="penalty-cell">处罚</th><th scope="col" class="points">积分</th></tr></thead>
    <tbody>{results.map((result) => {
      const penalties = race.penalties.filter((penalty) => penalty.driverId === result.driverId);
      const score = race.championshipPoints.find((entry) => entry.driverId === result.driverId);
      const summary = penalties.length ? penaltySummary(penalties) : undefined;
      const change = positionChange(result);
      const status = resultStatus(result, penalties);
      const dialogId = `score-${seriesSlug ?? 'race'}-${race.roundId}-${result.driverId}`;
      const penaltyDialogId = `penalty-${seriesSlug ?? 'race'}-${race.roundId}-${result.driverId}`;
      const crown = result.status !== 'disqualified' ? ({ 1: 'gold', 2: 'silver', 3: 'bronze' } as const)[result.position] : undefined;
      return <tr>
        <td class="pos">
          <strong class:list={['race-position', { 'ranked-position': result.status !== 'disqualified' && validPosition(result.position) }]}>
            {crown && <svg class:list={['podium-crown', crown]} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M3 6 7.5 10.5 12 3 16.5 10.5 21 6 18.5 17H5.5Z" />
              <path d="M6 20H18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>}
            {crown && <span class="sr-only">第 {result.position} 名</span>}
            {!crown && (result.status === 'disqualified' ? '取消资格' : validPosition(result.position) ? result.position : '—')}
          </strong>
          {seriesSlug && certificateIds.has(result.driverId) && <a class="certificate-link" href={certificateUrl(seriesSlug, race.roundId, result.driverId)} target="_blank" rel="noopener" aria-label={`在新标签页查看${result.driver}第${result.position}名证书 PDF`}>查看证书</a>}
        </td>
        <td class="number">#{result.carNumber}</td>
        <td class="driver"><strong>{result.driver}</strong></td>
        <td class="grid-column"><span class="grid-position">{validPosition(result.startPosition) ? result.startPosition : '—'}</span></td>
        <td class="change-column">{change ? <span class:list={['position-change', change.direction]} title={change.label}><span aria-hidden="true">{change.text}</span><span class="sr-only">{change.label}</span></span> : <span class="no-change"><span aria-hidden="true">—</span><span class="sr-only">无有效名次变化</span></span>}</td><td class="car">{result.car}</td><td>{result.laps}</td>
        <td class="race-status"><span>{status.label}</span>{status.reason && <small>{status.reasonLabel}：{status.reason}</small>}</td>
        <td>{result.gap}</td>
        <td class:list={['lap-time', { fastest: fastest?.driverId === result.driverId }]}>{result.bestLap}{fastest?.driverId === result.driverId && <span class="fl-badge">全场最快</span>}</td>
        {showIncidents && <td class="incidents-column">{result.incidents}</td>}
        <td class="penalty-cell">
          {summary ? <>
            <button class="penalty-open" type="button" data-result-dialog={penaltyDialogId} aria-haspopup="dialog" aria-controls={penaltyDialogId} aria-label={`查看${result.driver}的处罚明细：${summary.text}`} title="查看处罚明细">
              <span>{summary.text}</span>
            </button>
            <ResultDetailsDialog id={penaltyDialogId} title="处罚明细" eyebrow="本轮处罚" result={result} summaryLabel={summary.totalLabel} summaryValue={summary.text}>
              <dl>{penalties.map((penalty) => <div><dt>{penaltyLabel(penalty)}<small class="penalty-detail-reason">{penalty.reason ?? '未提供原因'}</small></dt>{penalty.type !== 'disqualification' && <dd>{penaltyValue(penalty)}</dd>}</div>)}</dl>
              {result.status === 'disqualified' && penalties.some((penalty) => penalty.type === 'time') && <p class="details-note">取消资格，罚时不再生效。</p>}
            </ResultDetailsDialog>
          </> : <span class="no-penalty" aria-label="无处罚">—</span>}
        </td>
        <td class="points score-cell">
          {score ? <>
            <button class="score-open" type="button" data-result-dialog={dialogId} aria-haspopup="dialog" aria-controls={dialogId} aria-label={`查看${result.driver}本轮 ${numberFormat.format(score.points)} 分的积分明细`} title="查看积分明细">
              <strong>{numberFormat.format(score.points)}</strong>
              <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7.5" /><path d="M10 9v5M10 6v.5" /></svg>
            </button>
            <ResultDetailsDialog id={dialogId} title="积分明细" eyebrow="本轮成绩" result={result} summaryLabel="本轮积分" summaryValue={numberFormat.format(score.points)} summaryUnit="分">
                <dl>
                  <div><dt>名次积分</dt><dd>{numberFormat.format(score.positionPoints)}</dd></div>
                  {score.poleBonus !== 0 && <div><dt>杆位奖励</dt><dd>{signedPoints(score.poleBonus)}</dd></div>}
                  {score.fastestLapBonus !== 0 && <div><dt>最快圈奖励</dt><dd>{signedPoints(score.fastestLapBonus)}</dd></div>}
                  {score.customBonusDetails.map((detail) => <div><dt>{detail.reason}</dt><dd>{signedPoints(detail.points)}</dd></div>)}
                  {score.penalty > 0 && <div class="score-deduction"><dt>扣分</dt><dd>−{numberFormat.format(score.penalty)}</dd></div>}
                </dl>
              {result.status === 'disqualified' && <p class="details-note">取消资格，本轮积分归零（扣分不再叠加）。</p>}
            </ResultDetailsDialog>
          </> : <strong>0</strong>}
        </td>
      </tr>;
    })}</tbody>
  </table>
</TableScroll>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .race-position { display: inline-flex; align-items: center; justify-content: center; gap: 5px; }
  .podium-crown { width: 18px; height: 18px; flex: 0 0 18px; fill: currentColor; }
  .podium-crown.gold { color: #d9a528; }
  .podium-crown.silver { color: #a8b2c1; }
  .podium-crown.bronze { color: #bb7c48; }
  .grid-column, .change-column { text-align: center; padding-inline: 10px; }
  .ranked-position { min-width: 28px; min-height: 28px; padding: 4px 6px; border-radius: 5px; background: var(--surface-muted); color: var(--ink); }
  .grid-position { color: var(--table-ink); font-size: 12px; font-weight: 650; }
  .position-change { display: inline-block; min-width: 36px; font-size: 12px; font-weight: 650; }
  .position-change.gain { color: var(--gain); }
  .position-change.loss { color: var(--loss); }
  .no-change, .position-change:not(.gain):not(.loss) { color: var(--faint); }
  .race-status { min-width: 100px; max-width: 180px; white-space: normal; }
  .race-status small { display: block; margin-top: 3px; color: var(--muted); font-size: 11px; overflow-wrap: anywhere; }
  .incidents-column { text-align: center; width: 72px; }
  .score-cell { width: 84px; }
  .penalty-cell { min-width: 118px; text-align: center; }
  .no-penalty { color: var(--faint); }
  .penalty-open { display: inline-flex; align-items: center; gap: 5px; min-height: 32px; padding: 4px 8px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface-muted); color: var(--muted); font: inherit; font-size: 11px; white-space: nowrap; vertical-align: middle; cursor: pointer; }
  .penalty-open:hover, .penalty-open:focus-visible { color: var(--accent-text); border-color: var(--accent-text); }
  .penalty-detail-reason { display: block; margin-top: 4px; color: var(--muted); font-size: 11px; line-height: 1.6; }
  .score-open { display: inline-flex; align-items: center; justify-content: flex-end; gap: 7px; min-height: 44px; min-width: 54px; padding: 6px 0 6px 8px; border: 0; border-radius: 5px; background: transparent; font: inherit; cursor: pointer; }
  .score-open strong { border-bottom: 1px dotted var(--line-strong); }
  .score-open svg { width: 15px; height: 15px; fill: none; stroke: var(--faint); stroke-width: 1.5; stroke-linecap: round; }
  .score-open:hover svg, .score-open:focus-visible svg { stroke: var(--accent-text); }
  .score-open:hover strong { border-color: var(--accent-text); }
  .score-deduction dd { color: var(--loss); }
</style>
