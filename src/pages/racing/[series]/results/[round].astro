---
import ResultPage from '../../../../components/ResultPage.astro';
import { getSeriesConfigs, getSeriesView } from '../../../../lib/data';

export function getStaticPaths() {
  return getSeriesConfigs().flatMap((seriesConfig) => {
    const view = getSeriesView(seriesConfig);
    return view.races.map((race) => ({
      params: { series: seriesConfig.slug, round: race.roundId },
      props: {
        seriesConfig,
        display: view.display,
        race,
        round: view.data.rounds.find((round) => round.id === race.roundId)!,
        sessions: view.eventSessions[race.roundId],
      },
    }));
  });
}
---
<ResultPage {...Astro.props} sessionKind="race" />
